@model Movie_Watchlist.Application.ViewModels.HomepageViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Rotating Banner -->
@if (Model.HeroMovies != null && Model.HeroMovies.Any())
{
    <div class="swiper hero-slider mb-5">
        <div class="swiper-wrapper">
            @foreach (var hero in Model.HeroMovies)
            {
                <div class="swiper-slide">
                    <div class="hero-slide" style="background-image: url('@hero.FullBackdropPath');">
                        <div class="hero-vignette"></div>
                        <div class="hero-content">
                            <h1 class="hero-title">@hero.Title</h1>
                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-star-fill text-warning me-2 fs-5"></i>
                                <span class="fw-bold fs-5 text-white">@hero.VoteAverage.ToString("0.0")</span>
                                <span class="text-light ms-1 opacity-75">/ 10</span>
                                @if (!string.IsNullOrEmpty(hero.ReleaseDate) && hero.ReleaseDate.Length >= 4)
                                {
                                    <span class="ms-3 text-light opacity-75">@hero.ReleaseDate.Substring(0, 4)</span>
                                }
                            </div>
                            <p class="hero-description text-light">@hero.Description</p>
                            <div class="hero-buttons d-flex gap-3">
                                <a asp-controller="Home" asp-action="DetailsByTmdb" asp-route-tmdbId="@hero.Id" class="btn btn-light fw-bold px-4 py-2 text-dark rounded-1">
                                    <i class="bi bi-play-fill fs-5 me-1 align-middle"></i> Explor
                                </a>
                              
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="swiper-pagination hero-pagination"></div>
    </div>
}

<div class="container-fluid px-0" style="overflow-x: hidden;">

    <!-- Trending Movies -->
    @await Html.PartialAsync("_CarouselSection", new { 
        Title = "🔥 Trending Movies", 
        Items = Model.TrendingMovies, 
        Category = "trending-movies", 
        IsMovie = true 
    })

    <!-- Trending TV Shows -->
    @await Html.PartialAsync("_CarouselSection", new { 
        Title = "🔥 Trending TV Shows", 
        Items = Model.TrendingTvShows, 
        Category = "trending-tv", 
        IsMovie = false 
    })

    <!-- Now Playing -->
    @await Html.PartialAsync("_CarouselSection", new { 
        Title = "🎬 Now Playing", 
        Items = Model.NowPlaying, 
        Category = "now-playing", 
        IsMovie = true 
    })

    <!-- Upcoming -->
    @await Html.PartialAsync("_CarouselSection", new { 
        Title = "📅 Upcoming (Coming Soon)", 
        Items = Model.Upcoming, 
        Category = "upcoming", 
        IsMovie = true 
    })

    <!-- Top Rated Movies -->
    @await Html.PartialAsync("_CarouselSection", new { 
        Title = "⭐ Top Rated Movies", 
        Items = Model.TopRatedMovies, 
        Category = "top-rated-movies", 
        IsMovie = true 
    })

    <!-- Top Rated TV Shows -->
    @await Html.PartialAsync("_CarouselSection", new { 
        Title = "📺 Top Rated TV Shows", 
        Items = Model.TopRatedTvShows, 
        Category = "top-rated-tv", 
        IsMovie = false 
    })

    <!-- Popular Movies -->
    @await Html.PartialAsync("_CarouselSection", new { 
        Title = "🔥 Popular Movies", 
        Items = Model.PopularMovies, 
        Category = "popular-movies", 
        IsMovie = true 
    })

    <!-- Popular TV Shows -->
    @await Html.PartialAsync("_CarouselSection", new { 
        Title = "📺 Popular TV Shows", 
        Items = Model.PopularTvShows, 
        Category = "popular-tv", 
        IsMovie = false 
    })

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            // Hero Slider (Autoplay & fade)
            const heroSwiper = new Swiper('.hero-slider', {
                effect: 'fade',
                fadeEffect: { crossFade: true },
                loop: true,
                autoplay: {
                    delay: 5000,
                    disableOnInteraction: false,
                },
                pagination: {
                    el: '.hero-pagination',
                    clickable: true,
                }
            });

            // Standard Carousels
            const carouselSwipers = new Swiper('.standard-carousel', {
                slidesPerView: 2,
                spaceBetween: 10,
                navigation: {
                    nextEl: '.swiper-button-next',
                    prevEl: '.swiper-button-prev',
                },
                breakpoints: {
                    576: { slidesPerView: 3, spaceBetween: 15 },
                    768: { slidesPerView: 4, spaceBetween: 15 },
                    992: { slidesPerView: 5, spaceBetween: 20 },
                    1200: { slidesPerView: 6, spaceBetween: 20 },
                    1400: { slidesPerView: 8, spaceBetween: 20 }
                }
            });
        });
    </script>
}