@model Movie_Watchlist.Application.ViewModels.MovieDisplayModel
@{
    ViewData["Title"] = "Home Page";
}


<div class="container mt-4">
    <form asp-action="Index" method="get" class="row g-3 align-items-center bg-light p-3 rounded shadow-sm">
        <div class="col-md-4">
            <label class="form-label fw-bold" for="genreId">Filter by Genre</label>
            <select class="form-select" id="genreId" name="genreId">
                <option value="0">All Genres</option>
                @foreach (var genre in Model.Genres)
                {
                    <option selected="@(genre.Id == Model.GenreId)" value="@genre.Id">@genre.Name</option>
                }
            </select>
        </div>

        <div class="col-md-5">
            <label class="form-label fw-bold" for="sTerm">Search Movie</label>
            <input type="text" class="form-control" value="@Model.STerm" id="sTerm" name="sTerm"
                placeholder="Enter movie title...">
        </div>

        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary me-2">Search</button>
            <a href="/Home/Index" class="btn btn-secondary">Reset</a>
        </div>
    </form>
    <h2 class="text-center mb-4">Latest Movies</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row row-cols-1 row-cols-md-4 g-4">
        @foreach (var movie in Model.Movies)
        {
            <div class="col">
                <div class="card h-100 shadow-sm position-relative">

                    <div class="position-absolute top-0 start-0 m-2" style="z-index: 5;">
                        @if (movie.IsInWatchlist)
                        {
                            <button class="btn btn-success btn-sm rounded-circle shadow toggle-watchlist"
                                data-movieid="@movie.Id" data-action="remove" type="button" style="width: 45px; height: 45px;">
                                <i class="bi bi-bookmark-check-fill text-white fs-4"></i>
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-light btn-sm rounded-circle shadow border toggle-watchlist"
                                data-movieid="@movie.Id" data-action="add" type="button" style="width: 45px; height: 45px;">
                                <i class="bi bi-bookmark-plus text-primary fs-4"></i>
                            </button>
                        }
                    </div>
                    <div class="card h-100 shadow-sm">
                        <a asp-action="Details" asp-route-id="@movie.Id" class="text-decoration-none">
                            <img src="@movie.PosterPath" class="card-img-top" alt="@movie.Title"
                                style="height: 350px; object-fit: cover; cursor: pointer;">
                        </a>
                        <div class="card-body">
                            <h5 class="card-title text-truncate">@movie.Title</h5>
                            <p class="card-text text-muted">@movie.ReleaseYear</p>
                            <p class="card-text text-muted">@movie.GenreName</p>

                        </div>
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="card-footer bg-white border-top-0 d-flex justify-content-between">
                                <a asp-area="Admin" asp-controller="Admin" asp-action="Edit" asp-route-id="@movie.Id"
                                    class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <form asp-area="Admin" asp-controller="Admin" asp-action="Delete" asp-route-id="@movie.Id"
                                    method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>

        }
    </div>

    @if (ViewBag.TotalItems > ViewBag.PageSize)
    {
        @await Component.InvokeAsync("Pagination", new {
    currentPage = ViewBag.CurrentPage,
    totalItems = ViewBag.TotalItems,
    pageSize = ViewBag.PageSize,
    actionName = "Index",
    routeParams = new Dictionary<string, string> {
    { "sTerm", Model.STerm ?? "" },
    { "genreId", Model.GenreId.ToString() }
    }
    })
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $(document).on("click", ".toggle-watchlist", function (e) {
                e.preventDefault();

                var btn = $(this);
                var movieId = btn.data("movieid");
                var action = btn.attr("data-action");


                var isAdd = action === "add";

                var config = {
                    url: isAdd ? '/Watchlist/AddItem' : '/Watchlist/RemoveItemAjax',
                    newAction: isAdd ? 'remove' : 'add',
                    removeCls: isAdd ? 'btn-light border' : 'btn-success',
                    addCls: isAdd ? 'btn-success' : 'btn-light border',
                    icon: isAdd ?
                        '<i class="bi bi-bookmark-check-fill text-white fs-4"></i>' :
                        '<i class="bi bi-bookmark-plus text-primary fs-4"></i>'
                };


                $.ajax({
                    url: config.url,
                    data: { movieId: movieId },
                    success: function () {
                        btn.removeClass(config.removeCls).addClass(config.addCls);
                        btn.attr("data-action", config.newAction);
                        btn.html(config.icon);
                    },
                    error: function (xhr) {
                        if (xhr.status === 401) {
                            window.location.href = "/Account/Login";
                            return;
                        }

                        alert("Something went wrong. Please try again.");
                    }
                });
            });
        });
    </script>
}