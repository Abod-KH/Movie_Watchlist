@using Movie_Watchlist.Application.ViewModels
@model MovieDisplayModel
@{
    ViewData["Title"] = "Browse Movies";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Latest Movies</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div id="media-grid" class="row row-cols-2 row-cols-md-4 row-cols-lg-5 g-4">
        @foreach (var movie in Model.Movies)
        {
            var card = movie.ToMediaCard();
            <div class="col">
                <partial name="_PosterCard" model="card" />
            </div>
        }
    </div>

    <!-- Infinite Scroll Sentinel -->
    <div id="scroll-sentinel" class="text-center py-4 mt-3" style="min-height: 70px;">
        <div id="loading-spinner" class="spinner-border text-primary d-none" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p id="end-of-results" class="text-muted d-none mb-0 fs-6">You've reached the end!</p>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            let currentPage = @(ViewBag.CurrentPage ?? 1);
            const totalItems = @(ViewBag.TotalItems ?? 0);
            const pageSize = @(ViewBag.PageSize ?? 30);
            let loading = false;
            let allLoaded = currentPage * pageSize >= totalItems;

            const grid = document.getElementById('media-grid');
            const sentinel = document.getElementById('scroll-sentinel');
            const spinner = document.getElementById('loading-spinner');
            const endMsg = document.getElementById('end-of-results');

            if (allLoaded) {
                endMsg.classList.remove('d-none');
            }

            const observer = new IntersectionObserver(async (entries) => {
                if (!entries[0].isIntersecting || loading || allLoaded) return;
                loading = true;
                spinner.classList.remove('d-none');

                currentPage++;
                const params = new URLSearchParams({
                    page: currentPage,
                    sTerm: '@Html.Raw(Model.Filter.STerm ?? "")',
                    genreId: '@Model.Filter.GenreId'
                });

                try {
                    const response = await fetch(`/Home/Movies?${params.toString()}`, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (!response.ok) throw new Error('Failed to load next page');

                    const html = await response.text();
                    grid.insertAdjacentHTML('beforeend', html);

                    if (currentPage * pageSize >= totalItems) {
                        allLoaded = true;
                        endMsg.classList.remove('d-none');
                    }
                } catch (err) {
                    console.error('Error fetching movies:', err);
                    currentPage--;
                } finally {
                    loading = false;
                    spinner.classList.add('d-none');
                }
            }, { rootMargin: '250px' });

            if (sentinel) {
                observer.observe(sentinel);
            }
        })();
    </script>
}