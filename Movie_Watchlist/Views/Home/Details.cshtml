@model Movie_Watchlist.Application.ViewModels.MovieDetailsViewModel
@{
    ViewData["Title"] = Model.Movie!.Title;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Movie.Title</li>
                </ol>
            </nav>

            <div class="card shadow-lg border-0 overflow-hidden">
                <div class="row g-0">
                    <div class="col-md-4">
                        <img src="@Model.Movie.PosterPath" class="img-fluid h-100" alt="@Model.Movie.Title" style="object-fit: cover; min-height: 500px;">
                    </div>
                    <div class="col-md-8">
                        <div class="card-body p-5">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h1 class="card-title display-5 fw-bold mb-1">@Model.Movie.Title</h1>
                                    <p class="text-muted fs-5">@Model.Movie.ReleaseYear &bull; @Model.Movie.Genre?.Name</p>
                                </div>
                                <div class="badge bg-primary fs-6 p-2">Movie</div>
                            </div>

                            <hr class="my-4">

                            <div class="mb-4">
                                <h4 class="fw-bold mb-3">Overview</h4>
                                <p class="card-text fs-5 leading-relaxed text-secondary-emphasis">
                                   @Model.Movie.Description
                                </p>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.TrailerKey as string))
                            {
                                <div class="mb-4 mt-4">
                                    <h4 class="fw-bold mb-3">Official Trailer</h4>
                                    <div class="ratio ratio-16x9 shadow-sm rounded overflow-hidden">
                                        <iframe src="https://www.youtube.com/embed/@Model.TrailerKey" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                                    </div>
                                </div>
                            }
                            else {
                                <div class="mt-4">
                                    <h4 class="fw-bold mb-3 text-muted">Official Trailer</h4>
                                    <div class="ratio ratio-16x9 rounded bg-light border d-flex align-items-center justify-content-center text-center">
                                        <div class="p-3">
                                            <span class="bi bi-play-btn fs-1 text-secondary opacity-50"></span>
                                            <p class="text-secondary small mt-2">Trailer not found</p>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="container mt-5">
                                <h3 class="fw-bold mb-4">More Like This</h3>

                                <div class="row">
                                    @if (Model.SimilarMovies != null && Model.SimilarMovies.Any())
                                    {
                                        foreach (var sim in Model.SimilarMovies)
                                        {
                                            <div class="col-6 col-md-3 col-lg-2 mb-4">
                                                <div class="card h-100 shadow-sm border-0">

                                                    <a asp-action="DetailsByTmdb" asp-route-tmdbId="@sim.Id">
                                                        <img src="@sim.FullPosterPath"
                                                             class="card-img-top"
                                                             alt="@sim.Title"
                                                             style="height: 250px; object-fit: cover;">
                                                    </a>

                                                    <div class="card-body p-2">
                                                        <p class="small fw-semibold mb-1 text-truncate">
                                                            @sim.Title
                                                        </p>

                                                        @if (!string.IsNullOrEmpty(sim.ReleaseDate))
                                                        {
                                                            <span class="text-muted small">
                                                                @sim.ReleaseDate.Substring(0, 4)
                                                            </span>
                                                        }
                                                    </div>

                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted">No similar movies found.</p>
                                    }
                                </div>
                            </div>

                            <div class="d-flex gap-3 mt-5">
                                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">
                                    <i class="bi bi-arrow-left me-2"></i>Back to Movies
                                </a>
                               
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


