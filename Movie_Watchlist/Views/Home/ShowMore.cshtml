@model Movie_Watchlist.Application.ViewModels.ShowMoreViewModel
@{
    ViewData["Title"] = Model.SectionTitle;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Model.SectionTitle</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Home
        </a>
    </div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <div id="media-grid" class="row row-cols-2 row-cols-md-4 row-cols-lg-5 g-4">
            @foreach (var item in Model.Items)
            {
                <div class="col">
                    <partial name="_PosterCard" model="item" />
                </div>
            }
        </div>

        <!-- Infinite Scroll Sentinel -->
        <div id="scroll-sentinel" class="text-center py-4 mt-3" style="min-height: 70px;">
            <div id="loading-spinner" class="spinner-border text-primary d-none" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p id="end-of-results" class="text-muted d-none mb-0 fs-6">You've reached the end!</p>
        </div>
    }
    else
    {
        <div class="alert alert-info">No items found for this category.</div>
    }
</div>

@section Scripts {
    @if (Model.Items != null && Model.Items.Any())
    {
        <script>
            (function () {
                let currentPage = @Model.CurrentPage;
                const totalItems = @Model.TotalItems;
                const pageSize = 30;
                let loading = false;
                let allLoaded = currentPage * pageSize >= totalItems;

                const grid = document.getElementById('media-grid');
                const sentinel = document.getElementById('scroll-sentinel');
                const spinner = document.getElementById('loading-spinner');
                const endMsg = document.getElementById('end-of-results');

                if (allLoaded) {
                    endMsg.classList.remove('d-none');
                }

                const observer = new IntersectionObserver(async (entries) => {
                    if (!entries[0].isIntersecting || loading || allLoaded) return;
                    loading = true;
                    spinner.classList.remove('d-none');

                    currentPage++;
                    const params = new URLSearchParams({
                        category: '@Model.Category',
                        page: currentPage
                    });

                    try {
                        const response = await fetch(`/Home/ShowMore?${params.toString()}`, {
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        if (!response.ok) throw new Error('Failed to load next page');

                        const html = await response.text();
                        grid.insertAdjacentHTML('beforeend', html);

                        if (currentPage * pageSize >= totalItems) {
                            allLoaded = true;
                            endMsg.classList.remove('d-none');
                        }
                    } catch (err) {
                        console.error('Error fetching show more items:', err);
                        currentPage--;
                    } finally {
                        loading = false;
                        spinner.classList.add('d-none');
                    }
                }, { rootMargin: '250px' });

                if (sentinel) {
                    observer.observe(sentinel);
                }
            })();
        </script>
    }
}
