<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow-lg py-2">
        <div class="container">

            <!-- ========================= -->
            <!-- Brand -->
            <!-- ========================= -->
            <a class="navbar-brand fw-bold d-flex align-items-center flex-shrink-0"
               asp-area=""
               asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-film text-primary me-2 fs-3"></i>

                <span class="text-white">MOVIE</span>
                <span class="text-primary">HUB</span>

            </a>


            <!-- ========================= -->
            <!-- Collapsible Navigation -->
            <!-- ========================= -->
            <div class="collapse navbar-collapse movie-navbar-menu"
                 id="mainNavbar">

                <!-- Navigation Links -->
                <ul class="navbar-nav mb-2 mb-lg-0 ms-lg-3 flex-shrink-0">

                    <!-- Movies -->
                    <li class="nav-item">
                        <a class="nav-link text-white-50"
                           asp-area=""
                           asp-controller="Home"
                           asp-action="Movies">

                            <i class="bi bi-film me-1"></i>
                            Movies

                        </a>
                    </li>


                    <!-- TV Shows -->
                    <li class="nav-item">
                        <a class="nav-link text-white-50"
                           asp-area=""
                           asp-controller="TvShow"
                           asp-action="Index">

                            <i class="bi bi-tv me-1"></i>
                            TV Shows

                        </a>
                    </li>


                    <!-- Watchlist -->
                    <li class="nav-item">
                        <a class="nav-link text-white-50"
                           asp-area=""
                           asp-controller="Watchlist"
                           asp-action="UserWatchlist">

                            <i class="bi bi-bookmark-heart me-1"></i>
                            My Watchlist

                        </a>
                    </li>

                </ul>


                <!-- ========================= -->
                <!-- Login inside mobile drawer -->
                <!-- ========================= -->
                <div class="mobile-login mt-2">
                    <partial name="_LoginPartial" />
                </div>

            </div>


            <!-- Spacer: pushes search & login to the right (desktop) -->
            <div class="navbar-spacer"></div>


            <!-- ========================= -->
            <!-- Search Icon -->
            <!-- ========================= -->
            <div class="search-trigger-wrapper">
                <button id="openSearchOverlayBtn"
                        type="button"
                        class="btn text-white-50 p-2 hover-text-white border-0 bg-transparent"
                        title="Search"
                        aria-label="Open search">

                    <i class="bi bi-search fs-4"></i>

                </button>
            </div>


            <!-- ========================= -->
            <!-- Desktop Login -->
            <!-- ========================= -->
            <div class="desktop-login flex-shrink-0">
                <partial name="_LoginPartial" />
            </div>


            <!-- ========================= -->
            <!-- Mobile Hamburger -->
            <!-- ========================= -->
            <button class="navbar-toggler border-0 ms-2"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <i class="bi bi-list fs-1 text-white"></i>

            </button>

        </div>
    </nav>
</header>


<!-- ================================================= -->
<!-- Full-Screen Dark Backdrop -->
<!-- ================================================= -->
<div id="searchBackdrop"
     class="prime-search-backdrop"
     style="display: none;">
</div>


<!-- ================================================= -->
<!-- Search Overlay -->
<!-- ================================================= -->
<div id="primeSearchOverlay"
     class="prime-search-overlay"
     style="display: none;">

    <div class="container py-3 py-md-4">

        <div class="row justify-content-center">

            <div class="col-12 col-lg-10 col-xl-8">

                <div class="search-panel-card p-4 rounded-4 shadow-lg border border-secondary border-opacity-50 position-relative">


                    <!-- ========================= -->
                    <!-- Search Panel Header -->
                    <!-- ========================= -->
                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <span class="text-white-50 fw-semibold text-uppercase tracking-wider small">

                            <i class="bi bi-search text-primary me-2"></i>

                            Search Movies & TV Shows

                        </span>


                        <button id="closeSearchOverlayBtn"
                                type="button"
                                class="btn btn-sm text-white-50 hover-text-white border-0 p-1"
                                title="Close (Esc)"
                                aria-label="Close search">

                            <i class="bi bi-x-lg fs-5"></i>

                        </button>

                    </div>


                    <!-- ========================= -->
                    <!-- Search Form -->
                    <!-- ========================= -->
                    <form id="overlaySearchForm"
                          action="/Search/Index"
                          method="get">

                        <div class="position-relative d-flex gap-2">

                            <div class="position-relative flex-grow-1">

                                <input type="text"
                                       id="globalSearchInput"
                                       name="q"
                                       class="form-control form-control-lg search-overlay-input text-white bg-dark border-2 border-white rounded-3 ps-5 py-3 shadow-none fs-5"
                                       placeholder="Search movies, TV shows..."
                                       autocomplete="off">

                                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 fs-5 text-light opacity-75"></i>

                            </div>


                            <button type="submit"
                                    class="btn btn-primary btn-lg px-4 rounded-3 flex-shrink-0 fw-semibold"
                                    title="Go to full search">

                                <i class="bi bi-arrow-right-circle-fill"></i>

                            </button>

                        </div>


                        <!-- ========================= -->
                        <!-- Autocomplete -->
                        <!-- ========================= -->
                        <div id="autocompleteResults"
                             class="mt-3 search-results-container rounded-3 shadow-lg"
                             style="display: none;">

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>