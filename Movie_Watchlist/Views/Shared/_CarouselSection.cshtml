@model dynamic
@{
    var title = Model.Title;
    var items = Model.Items;
    var category = Model.Category;
    var isMovie = Model.IsMovie;
    
    // We expect items to be IEnumerable<dynamic> (either MovieApiResult or TvShowApiResult)
}

@if (items != null)
{
    <div class="carousel-section position-relative">
        <div class="section-header">
            <h2 class="section-title mb-0">@title</h2>
            <a asp-action="ShowMore" asp-route-category="@category" class="show-more-link fw-bold ms-2">
                Show More <i class="bi bi-chevron-right small"></i>
            </a>
        </div>

        <div class="swiper standard-carousel">
            <div class="swiper-wrapper">
                @foreach (var item in items)
                {
                    <div class="swiper-slide">
                        @{
                            var isTv = item.GetType().Name.Contains("TvShow");
                            double rating = 0;
                            try { rating = item.VoteAverage; } catch { try { rating = item.Rating; } catch { } }

                            var mediaVM = new Movie_Watchlist.Application.ViewModels.MediaHomeViewModel
                            {
                                TmdbId = item.Id,
                                Title = item.Title ?? "Unknown",
                                PosterPath = item.FullPosterPath,
                                Rating = rating,
                                MediaType = isMovie ? "movie" : "tv",
                                ReleaseYear = 0
                            };
                            
                            try {
                                string dateStr = isTv ? item.FirstAirDate : item.ReleaseDate;
                                if (!string.IsNullOrEmpty(dateStr) && dateStr.Length >= 4) {
                                    mediaVM.ReleaseYear = int.Parse(dateStr.Substring(0, 4));
                                }
                            } catch { }
                        }
                        <partial name="_PosterCard" model="mediaVM" />
                    </div>
                }
            </div>
            
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
        </div>
    </div>
}
