@using Movie_Watchlist.Application.ViewModels
@model MediaHomeViewModel

@{
    var posterUrl = Model.PosterPath != null
        ? (Model.PosterPath.StartsWith("http") ? Model.PosterPath : $"https://image.tmdb.org/t/p/w500{Model.PosterPath}")
        : "/images/no-poster.jpg"; // Fallback image

    var detailsUrl = Model.MediaType == "tv" 
        ? Url.Action("Details", "TvShow", new { id = Model.Id }) 
        : Url.Action("Details", "Home", new { id = Model.Id });

    // If Id is 0, it means it's an API result without a local DB ID yet, fallback to TMDB Details
    if (Model.Id == 0 && Model.TmdbId > 0)
    {
        detailsUrl = Model.MediaType == "tv"
            ? Url.Action("DetailsByTmdb", "TvShow", new { tmdbId = Model.TmdbId })
            : Url.Action("DetailsByTmdb", "Home", new { tmdbId = Model.TmdbId });
    }
}

<a href="@detailsUrl" class="text-decoration-none d-block poster-card-container">
    <div class="poster-card position-relative overflow-hidden rounded shadow-sm">
        <img src="@posterUrl" alt="@Model.Title" class="w-100 h-100 object-fit-cover" loading="lazy" style="aspect-ratio: 2/3;">
        
        <!-- Rating Badge (Top Right) -->
        <div class="position-absolute top-0 end-0 m-2 px-2 py-1 bg-dark bg-opacity-75 text-white fw-bold rounded-1" style="font-size: 0.85rem;">
            @(Model.Rating > 0 ? Model.Rating.ToString("0.0") : "NR")
        </div>

        <!-- Overlay Details -->
        <div class="poster-overlay position-absolute bottom-0 start-0 w-100 p-3 bg-dark bg-opacity-75 text-white">
            <h6 class="mb-1 text-truncate fw-bold">@Model.Title</h6>
            <div class="d-flex justify-content-between align-items-center small">
                <span>@(Model.ReleaseYear > 0 ? Model.ReleaseYear.ToString() : "")</span>
                <span>
                    @if (Model.MediaType == "tv")
                    {
                        <i class="bi bi-tv text-info"></i>
                    }
                    else
                    {
                        <i class="bi bi-film text-warning"></i>
                    }
                </span>
            </div>
        </div>
    </div>
</a>

<style>
    .poster-card-container .poster-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .poster-card-container:hover .poster-card {
        transform: translateY(-5px) scale(1.02);
        box-shadow: 0 10px 20px rgba(0,0,0,0.5) !important;
        z-index: 10;
    }
    .poster-overlay {
        opacity: 0;
        transition: opacity 0.3s ease;
        background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
    }
    .poster-card-container:hover .poster-overlay {
        opacity: 1;
    }
</style>
