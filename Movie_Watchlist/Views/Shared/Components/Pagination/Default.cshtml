@model Movie_Watchlist.Application.ViewModels.PaginationViewModel

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-5">
        <ul class="pagination pagination-sm flex-wrap justify-content-center">
            @{
                var firstPageRoutes = new Dictionary<string, string>(Model.RouteParams) { { "page", "1" } };
                var prevPageRoutes = new Dictionary<string, string>(Model.RouteParams) { { "page", (Model.CurrentPage - 1).ToString() } };
                var nextPageRoutes = new Dictionary<string, string>(Model.RouteParams) { { "page", (Model.CurrentPage + 1).ToString() } };
                var lastPageRoutes = new Dictionary<string, string>(Model.RouteParams) { { "page", Model.TotalPages.ToString() } };
            }

            @* First Page *@
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.ActionName" asp-controller="@(string.IsNullOrEmpty(Model.ControllerName) ? null : Model.ControllerName)" asp-all-route-data="firstPageRoutes" title="First Page">
                    &laquo;&laquo; First
                </a>
            </li>

            @* Previous *@
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.ActionName" asp-controller="@(string.IsNullOrEmpty(Model.ControllerName) ? null : Model.ControllerName)" asp-all-route-data="prevPageRoutes">&laquo;</a>
            </li>

            @{
                int startPage = Math.Max(1, Model.CurrentPage - 5);
                int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 5);
            }

            @for (int i = startPage; i <= endPage; i++)
            {
                var pageRoutes = new Dictionary<string, string>(Model.RouteParams) { { "page", i.ToString() } };
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="@Model.ActionName" asp-controller="@(string.IsNullOrEmpty(Model.ControllerName) ? null : Model.ControllerName)" asp-all-route-data="pageRoutes">@i</a>
                </li>
            }

            @* Next *@
            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.ActionName" asp-controller="@(string.IsNullOrEmpty(Model.ControllerName) ? null : Model.ControllerName)" asp-all-route-data="nextPageRoutes">&raquo;</a>
            </li>

            @* Last Page *@
            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.ActionName" asp-controller="@(string.IsNullOrEmpty(Model.ControllerName) ? null : Model.ControllerName)" asp-all-route-data="lastPageRoutes" title="Last Page">
                    Last &raquo;&raquo;
                </a>
            </li>
        </ul>
    </nav>
}
