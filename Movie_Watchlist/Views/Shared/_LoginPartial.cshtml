<ul class="navbar-nav align-items-center">
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <li class="nav-item me-lg-2">
            <span class="nav-link text-white-50 small">
                <i class="bi bi-person-circle"></i> @User.Identity.Name
            </span>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline-light btn-sm px-3 rounded-pill">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-white-50" asp-controller="Account" asp-action="Register">Register</a>
        </li>
        <li class="nav-item ms-lg-2">
            <a class="btn btn-primary btn-sm px-4 rounded-pill shadow-sm" asp-controller="Account" asp-action="Login">
                Login
            </a>
        </li>
    }
</ul>