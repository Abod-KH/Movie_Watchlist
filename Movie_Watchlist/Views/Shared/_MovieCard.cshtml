@model dynamic

<div class="card h-100 shadow-sm border-0 @(ViewBag.IsWatchlistPage == true && Model.IsWatched ? "opacity-75" : "")">
    
    <div class="position-absolute top-0 start-0 m-2" style="z-index: 5;">
        @if (ViewBag.IsHomePage == true)
        {
            @if (Model.IsInWatchlist)
            {
                <button class="btn btn-success btn-sm rounded-circle shadow" style="width: 45px; height: 45px;" disabled>
                    <i class="bi bi-bookmark-check-fill fs-4"></i>
                </button>
            }
            else
            {
                <button class="btn btn-light btn-sm rounded-circle shadow border add-to-watchlist"
                        data-movieid="@Model.Id" type="button" style="width: 45px; height: 45px;">
                    <i class="bi bi-bookmark-plus text-primary fs-4"></i>
                </button>
            }
        }
    </div>

    <img src="@Model.PosterPath" class="card-img-top" alt="@Model.Title"
         style="height: 350px; object-fit: cover;"
         onerror="this.onerror=null;this.src='https://placehold.co/500x750?text=No+Poster+Found';">

    <div class="card-body">
        <h5 class="card-title text-truncate">@Model.Title</h5>
        <p class="card-text text-muted small">
            @Model.ReleaseYear
            @if (ViewBag.IsHomePage == true)
            {
                <span>• @Model.GenreName</span>
            }
        </p>

        @if (ViewBag.IsWatchlistPage == true)
        {
            <div class="form-check mt-2">
                <input class="form-check-input watch-check" type="checkbox"
                       data-movieid="@Model.MovieId" @(Model.IsWatched ? "checked" : "") id="check-@Model.MovieId">
                <label class="form-check-label small" for="check-@Model.MovieId">Mark as Watched</label>
            </div>
        }
    </div>

    <div class="card-footer bg-white border-top-0 d-grid gap-2">
        @if (ViewBag.IsWatchlistPage == true)
        {
            <a asp-controller="Watchlist" asp-action="RemoveItem" asp-route-movieId="@Model.MovieId"
                   class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure?')">
                <i class="bi bi-trash"></i> Remove
            </a>
        }

        @if (User.IsInRole("Admin") && ViewBag.IsHomePage == true)
        {
            <div class="d-flex justify-content-between">
                <a asp-area="Admin" asp-controller="Admin" asp-action="Edit" asp-route-id="@Model.Id"
                   class="btn btn-sm btn-outline-primary">Edit</a>
                <form asp-area="Admin" asp-controller="Admin" asp-action="Delete" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Are you sure?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </div>
        }
    </div>
</div>