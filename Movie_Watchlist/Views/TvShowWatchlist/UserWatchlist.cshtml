@model Movie_Watchlist.Application.ViewModels.TvShowWatchlistDashboardViewModel
@{
    ViewData["Title"] = "My TV Show Watchlist";
}

<div class="d-flex justify-content-between align-items-center my-4">
    <h2><i class="bi bi-bookmark-heart-fill text-danger"></i> My Watchlist</h2>
    <a href="/TvShow/Index" class="btn btn-outline-secondary">
        <i class="bi bi-plus-lg"></i> Add More TV Shows
    </a>
</div>

<ul class="nav nav-tabs mb-4">
  <li class="nav-item">
    <a class="nav-link" href="/Watchlist/UserWatchlist">Movies</a>
  </li>
  <li class="nav-item">
    <a class="nav-link active" href="/TvShowWatchlist/UserWatchlist">TV Shows</a>
  </li>
</ul>

<div id="tv-watchlist-content">
    <partial name="_WatchlistContent" model="Model" />
</div>

