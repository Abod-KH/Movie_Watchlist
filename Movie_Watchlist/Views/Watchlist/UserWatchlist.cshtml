@model Movie_Watchlist.Application.Models.WatchlistDashboardViewModel
@{
    ViewData["Title"] = "My Watchlist";
}

<div class="d-flex justify-content-between align-items-center my-4">
    <h2><i class="bi bi-bookmark-heart-fill text-danger"></i> My Watchlist</h2>
    <a href="/Home/Index" class="btn btn-outline-secondary">
        <i class="bi bi-plus-lg"></i> Add More Movies
    </a>
</div>

<div id="watchlist-content">
    <partial name="_WatchlistContent" model="Model" />
</div>

@section Scripts {
    <script>
        
        $(document).on("change", ".watch-check", function () {
            const movieId = $(this).data("movieid");

            $.post("/Watchlist/ToggleWatched", { movieId: movieId }, function () {
                // Fetch the updated partial view and swap it out
                $("#watchlist-content").load("/Watchlist/GetWatchlistPartial");
            }).fail(function() {
                alert("Could not update status.");
            });
        });
    </script>
}