@model Movie_Watchlist.Application.Models.WatchlistDashboardViewModel
@{
    ViewData["Title"] = "My Watchlist";
}

<div class="d-flex justify-content-between align-items-center my-4">
    <h2><i class="bi bi-bookmark-heart-fill text-danger"></i> My Watchlist</h2>
    <div id="add-more-container">
        <a href="/Home/Index" class="btn btn-outline-secondary" id="add-more-movies">
            <i class="bi bi-plus-lg"></i> Add More Movies
        </a>
        <a href="/TvShow/Index" class="btn btn-outline-secondary d-none" id="add-more-tvshows">
            <i class="bi bi-plus-lg"></i> Add More TV Shows
        </a>
    </div>
</div>

<ul class="nav nav-tabs mb-4">
  <li class="nav-item">
    <a class="nav-link tab-link active" href="javascript:void(0)" data-url="/Watchlist/GetWatchlistPartial" data-type="movies">Movies</a>
  </li>
  <li class="nav-item">
    <a class="nav-link tab-link" href="javascript:void(0)" data-url="/TvShowWatchlist/GetWatchlistPartial" data-type="tvshows">TV Shows</a>
  </li>
</ul>

<div id="watchlist-content">
    <partial name="_WatchlistContent" model="Model" />
</div>

@section Scripts {
    <script>
        let currentType = "movies";

        $(document).on("click", ".tab-link", function (e) {
            e.preventDefault();
            $(".tab-link").removeClass("active");
            $(this).addClass("active");
            const url = $(this).data("url");
            currentType = $(this).data("type");
            
            if(currentType === "movies") {
                $("#add-more-movies").removeClass("d-none");
                $("#add-more-tvshows").addClass("d-none");
            } else {
                $("#add-more-movies").addClass("d-none");
                $("#add-more-tvshows").removeClass("d-none");
            }

            $("#watchlist-content").load(url);
        });

        $(document).on("submit", ".remove-form", function(e) {
            e.preventDefault();
            const form = $(this);
            $.ajax({
                url: form.attr("action"),
                type: form.attr("method"),
                data: form.serialize(),
                success: function() {
                    const activeUrl = $(".tab-link.active").data("url");
                    $("#watchlist-content").load(activeUrl);
                }
            });
        });
        
        // Handle pagination clicks within the partial without full reload
        $(document).on("click", ".page-link", function(e) {
            const url = $(this).attr("href");
            if(url && url !== "#" && !url.startsWith("javascript")) {
                e.preventDefault();
                $("#watchlist-content").load(url);
            }
        });
    </script>
}