@model Movie_Watchlist.Application.ViewModels.TvShowDetailsViewModel
@{
    ViewData["Title"] = Model.TvShow.Title;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <img src="@Model.TvShow.PosterPath" alt="@Model.TvShow.Title" class="img-fluid rounded shadow" />
        </div>
        <div class="col-md-8">
            <h2>@Model.TvShow.Title</h2>
            <div class="mb-3 d-flex align-items-center">
                <span class="badge bg-secondary me-2">@Model.TvShow.ReleaseYear</span>
                <span class="badge bg-info text-dark me-2">@Model.TvShow.GenreName</span>
                <span class="badge bg-warning text-dark"><i class="bi bi-star-fill"></i> @Model.TvShow.Rating.ToString("0.0")</span>
                
                @if (User.Identity.IsAuthenticated)
                {
                    <button class="btn btn-outline-primary ms-4 btn-sm fw-bold toggle-tv-watchlist"
                            data-showid="@Model.TvShow.Id" data-action="add" type="button">
                        <i class="bi bi-plus-lg me-1"></i> Add to Watchlist
                    </button>
                }
            </div>
            
            <h4>Overview</h4>
            <p>@Model.TvShow.Description</p>

            @if (!string.IsNullOrEmpty(Model.TrailerKey))
            {
                <h4 class="mt-4">Trailer</h4>
                <div class="ratio ratio-16x9 mt-2">
                    <iframe src="https://www.youtube.com/embed/@Model.TrailerKey" title="YouTube video player" allowfullscreen></iframe>
                </div>
            }
        </div>
    </div>

    @if (Model.SimilarTvShows.Any())
    {
        <h3 class="mt-5 mb-4">Similar TV Shows</h3>
        <div class="row row-cols-2 row-cols-md-5 g-3">
            @foreach (var show in Model.SimilarTvShows)
            {
                <div class="col">
                    @{
                        var mediaVM = new Movie_Watchlist.Application.ViewModels.MediaHomeViewModel
                        {
                            TmdbId = show.Id,
                            Title = show.Title ?? "Unknown",
                            PosterPath = show.FullPosterPath,
                            Rating = show.Rating,
                            MediaType = "tv",
                            ReleaseYear = 0
                        };
                        
                        if (!string.IsNullOrEmpty(show.FirstAirDate) && show.FirstAirDate.Length >= 4) {
                            mediaVM.ReleaseYear = int.Parse(show.FirstAirDate.Substring(0, 4));
                        }
                    }
                    <partial name="_PosterCard" model="mediaVM" />
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $(".toggle-tv-watchlist").click(function (e) {
                e.preventDefault();
                var btn = $(this);
                var showId = btn.data("showid");
                
                $.post('/TvShowWatchlist/AddItem', { tvShowId: showId, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function() {
                    btn.removeClass('btn-outline-primary').addClass('btn-success').html('<i class="bi bi-check-lg me-1"></i> Added');
                    btn.attr('disabled', true);
                }).fail(function() {
                    alert('Failed to add to watchlist or already added.');
                });
            });
        });
    </script>
}
